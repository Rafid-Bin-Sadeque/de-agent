# DEMO-ONLY credentials for the local Acme Shop demo stack. Not secrets: they guard throwaway containers
# bound to 127.0.0.1. `make demo-up` copies this file to demo/.env (gitignored) if it does not exist.
DEMO_SRC_PASSWORD=demo-src-only
DEMO_ETL_PASSWORD=demo-etl-only
DEMO_WH_PASSWORD=demo-readonly-only
DEMO_AF_PASSWORD=demo-agent-ro-only
DEMO_AF_ADMIN_PASSWORD=demo-admin-only
DEMO_S3_USER=demo-s3
DEMO_S3_PASSWORD=demo-s3-only-secret
# host ports (all bound to 127.0.0.1)
DEMO_SRC_PORT=5440
DEMO_WH_PORT=5441
DEMO_AF_PORT=8085
DEMO_S3_PORT=8333
